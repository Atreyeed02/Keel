APP_NAME=ledger-service
ENVIRONMENT=development
# postgres://, postgresql:// and postgresql+asyncpg:// all work; sslmode may be in the URL
DATABASE_URL=postgresql+asyncpg://ledger:ledger@localhost:5432/ledger
# TLS to Postgres: disable, allow, prefer, require, verify-ca or verify-full.
# Overrides an sslmode in DATABASE_URL. Leave unset for the driver default.
# DATABASE_SSL=require
# Where `python -m app.serve` listens; most hosts set PORT themselves.
PORT=8000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
LOG_LEVEL=INFO
